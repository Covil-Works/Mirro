import { LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import "./fonts/Poppins-Regular.ttf";
import "./fonts/Poppins-Medium.ttf";
import "./fonts/Poppins-SemiBold.ttf";
import "./fonts/Poppins-Bold.ttf";

export struct DeviceCardData {
    serial: string,
    model: string,
    display_name: string,
    status_text: string,
    status_message: string,
    is_ready: bool,
    is_unauthorized: bool,
    is_mirroring: bool,
}

export struct MirroFileData {
    name: string,
    file_type: string,
    is_dir: bool,
}

component MonoButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> custom_height: 36px;
    in property <length> padding_horizontal: 18px;
    callback clicked();

    height: root.custom_height;
    min-width: label.min-width + (root.padding_horizontal * 2);
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? #222222 : #ffffff;
    background: !root.enabled ? #111111 : (ta.has-hover ? #000000 : #ffffff);

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.padding_horizontal;
        padding-right: root.padding_horizontal;
        alignment: center;
        cross-axis-alignment: center;

        label := Text {
            text: root.text;
            color: !root.enabled ? #444444 : (ta.has-hover ? #ffffff : #000000);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component MonoToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);

    height: 28px;
    background: transparent;

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 2px;
            border-width: 1px;
            border-color: #ffffff;
            background: root.checked ? #ffffff : (ta.has-hover ? #1a1a1a : #000000);

            if root.checked: Rectangle {
                width: 8px;
                height: 8px;
                background: #000000;
                border-radius: 1px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.label != "": Text {
            text: root.label;
            color: ta.has-hover ? #ffffff : #999999;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip: "";
    in property <bool> enabled: true;
    in property <length> custom_height: 38px;
    out property <bool> has_hover: ta.has-hover;
    callback clicked();

    height: root.custom_height;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: 1px;
    border-color: !root.enabled ? #222222 : #ffffff;
    background: !root.enabled ? #111111 : (ta.has-hover ? #000000 : #ffffff);

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Rectangle {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            colorize: !root.enabled ? #444444 : (ta.has-hover ? #ffffff : #000000);
        }
    }
}

component ContextMenuItem inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 25px;
    border-radius: 3px;
    background: ta.has-hover ? #222222 : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Text {
            text: root.text;
            color: ta.has-hover ? #ffffff : #bbbbbb;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

component FileContextMenu inherits Rectangle {
    in property <bool> is_dir: false;
    in property <bool> can_paste: false;
    callback open_clicked();
    callback copy_clicked();
    callback cut_clicked();
    callback paste_clicked();
    callback select_clicked();
    callback delete_clicked();
    callback download_clicked();

    width: 155px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #333333;
    background: #0d0d0d;
    clip: true;

    VerticalLayout {
        padding: 5px;
        spacing: 2px;

        ContextMenuItem {
            text: root.is_dir ? "ABRIR PASTA" : "ABRIR / EDITAR";
            clicked => { root.open_clicked(); }
        }

        Rectangle { height: 1px; background: #1c1c1c; }

        ContextMenuItem {
            text: "COPIAR";
            clicked => { root.copy_clicked(); }
        }

        ContextMenuItem {
            text: "RECORTAR";
            clicked => { root.cut_clicked(); }
        }

        if root.can_paste: ContextMenuItem {
            text: "COLAR";
            clicked => { root.paste_clicked(); }
        }

        ContextMenuItem {
            text: "SELECIONAR";
            clicked => { root.select_clicked(); }
        }

        Rectangle { height: 1px; background: #1c1c1c; }

        ContextMenuItem {
            text: "BAIXAR NO PC";
            clicked => { root.download_clicked(); }
        }

        ContextMenuItem {
            text: "APAGAR";
            clicked => { root.delete_clicked(); }
        }
    }
}

component QuickShortcutItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 28px;
    background: ta.has-hover ? #121212 : transparent;
    border-radius: 4px;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: space-between;
        cross-axis-alignment: center;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            Rectangle {
                width: 14px;
                height: 14px;
                Image {
                    source: root.icon;
                    width: 14px;
                    height: 14px;
                    colorize: root.checked ? #ffffff : #555555;
                }
            }

            Text {
                text: root.label;
                color: root.checked ? #ffffff : (ta.has-hover ? #cccccc : #777777);
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 2px;
            border-width: 1px;
            border-color: root.checked ? #ffffff : #333333;
            background: root.checked ? #ffffff : (ta.has-hover ? #1a1a1a : #000000);

            if root.checked: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 1px;
                background: #000000;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

component CompButton inherits Rectangle {
    in property <image> icon;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: cta.has-hover ? #ffffff : transparent;

    cta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            colorize: cta.has-hover ? #000000 : #ffffff;
        }
    }
}

component NavButton inherits Rectangle {
    in property <image> icon_image;
    in property <string> label;
    in property <string> badge_text: "";
    in property <bool> is_active: false;
    callback clicked();

    height: 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.is_active ? #ffffff : (ta.has-hover ? #2a2a2a : transparent);
    background: root.is_active ? #161616 : (ta.has-hover ? #0f0f0f : transparent);

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    // Indicador ativo na borda esquerda
    if root.is_active: Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: #ffffff;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        // Ícone vetorial com container de dimensão fixa e centralização garantida
        Rectangle {
            width: 16px;
            height: 16px;
            clip: false;

            Image {
                source: root.icon_image;
                width: 16px;
                height: 16px;
                colorize: root.is_active ? #ffffff : (ta.has-hover ? #ffffff : #777777);
            }
        }

        // Texto do botão
        Text {
            text: root.label;
            color: root.is_active ? #ffffff : (ta.has-hover ? #ffffff : #888888);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }

        // Badge opcional (contador)
        if root.badge_text != "": Rectangle {
            height: 18px;
            border-radius: 9px;
            background: root.is_active ? #ffffff : #1e1e1e;
            border-width: 1px;
            border-color: root.is_active ? #ffffff : #333333;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.badge_text;
                    color: root.is_active ? #000000 : #888888;
                    font-size: 9px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component GenericPhoneFrame inherits Rectangle {
    in property <string> display_name: "";
    in property <string> serial: "";
    in property <string> model: "";
    in property <bool> is_ready: false;
    in property <bool> is_mirroring: false;
    in property <bool> is_unauthorized: false;
    in property <bool> has_device: false;
    in property <image> screen_image;
    in property <bool> has_screen_image: false;
    callback mirror_clicked();

    width: 296px;
    height: 580px;
    background: transparent;

    // BOTÕES FÍSICOS LATERAIS DO IPHONE (Chassi Externo)
    // Esquerda: Botão de Ação (Action Button)
    Rectangle {
        x: 0px;
        y: 88px;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Esquerda: Volume +
    Rectangle {
        x: 0px;
        y: 118px;
        width: 3px;
        height: 38px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Esquerda: Volume -
    Rectangle {
        x: 0px;
        y: 164px;
        width: 3px;
        height: 38px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Direita: Botão Lateral (Power / Siri)
    Rectangle {
        x: parent.width - 3px;
        y: 124px;
        width: 3px;
        height: 52px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Direita inferior: Controle de Câmera (Camera Control - iPhone 16)
    Rectangle {
        x: parent.width - 3px;
        y: 430px;
        width: 2.5px;
        height: 28px;
        border-radius: 1px;
        background: #252525;
    }

    // CHASSI PRINCIPAL DO IPHONE (Moldura de Titânio Fosco com Linhas de Antena)
    chassis := Rectangle {
        x: 3px;
        y: 0px;
        width: 290px;
        height: 580px;
        border-radius: 48px;
        background: #0d0d0d;
        border-width: 2px;
        border-color: #383838;

        // Linhas de antena do iPhone (entalhes sutis nas laterais do titânio)
        Rectangle { x: 0px; y: 60px; width: 2px; height: 2px; background: #222222; }
        Rectangle { x: parent.width - 2px; y: 60px; width: 2px; height: 2px; background: #222222; }
        Rectangle { x: 0px; y: parent.height - 62px; width: 2px; height: 2px; background: #222222; }
        Rectangle { x: parent.width - 2px; y: parent.height - 62px; width: 2px; height: 2px; background: #222222; }

        // Borda Chanfrada de Titânio/Alumínio Fosco (Anel interno de reflexo)
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: parent.width - 3px;
            height: parent.height - 3px;
            border-radius: 46.5px;
            border-width: 1px;
            border-color: #222222;
            background: transparent;
        }

        // Fenda ultrafina do alto-falante auricular no topo do vidro
        Rectangle {
            y: 2.5px;
            x: (parent.width - self.width) / 2;
            width: 44px;
            height: 1.5px;
            border-radius: 0.75px;
            background: #242424;
        }

        // TELA DO IPHONE: Borda ultrafina, perfeitamente uniforme e simétrica em todos os lados (5px)
        screen := Rectangle {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            border-radius: 43px;
            background: #000000;
            border-width: 1px;
            border-color: #1a1a1a;
            clip: true;

            // Fundo da tela do smartphone com captura real desfocada (blur)
            if root.has_screen_image: Image {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                source: root.screen_image;
                image-fit: cover;
            }

            // Película escura sutil sobre o desfoque para contraste e legibilidade
            if root.has_screen_image: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #00000055;
            }

            // Ilha Dinâmica (Dynamic Island) no topo da tela do iPhone
            Rectangle {
                y: 10px;
                x: (parent.width - self.width) / 2;
                width: 82px;
                height: 24px;
                border-radius: 12px;
                background: #000000;
                border-width: 1px;
                border-color: #1e1e1e;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    // Sensor Face ID (TrueDepth)
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: #0c0c0c;
                    }

                    // Câmera Frontal (lente com anel óptico escuro)
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: #060606;
                        border-width: 1px;
                        border-color: #181818;
                    }
                }
            }

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 14px;
                padding-bottom: 10px;
                alignment: space-between;

                // Barra de Status Superior do iOS
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    // Hora de lançamento da Apple (9:41)
                    Text {
                        text: "9:41";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }

                    // Ícones de status do iOS (Sinal, Bateria)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        cross-axis-alignment: center;

                        Text {
                            text: "5G";
                            color: #ffffff;
                            font-size: 10px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        // Indicador de Bateria estilo iOS
                        HorizontalLayout {
                            spacing: 1.5px;
                            alignment: center;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 20px;
                                height: 10px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #888888;
                                background: transparent;

                                Rectangle {
                                    x: 1.5px;
                                    y: 1.5px;
                                    width: 13px;
                                    height: 7px;
                                    border-radius: 1.5px;
                                    background: #ffffff;
                                }
                            }

                            Rectangle {
                                width: 1.5px;
                                height: 4px;
                                border-radius: 0.75px;
                                background: #888888;
                            }
                        }
                    }
                }

                // Conteúdo central da tela
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    if !root.has_device: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "SEM DISPOSITIVO";
                            color: #444444;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                        }
                    }

                    if root.has_device && root.is_unauthorized: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Rectangle {
                            height: 26px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #ffffff;
                            background: #000000;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                cross-axis-alignment: center;
                                Text {
                                    text: "NÃO AUTORIZADO";
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.serial;
                            color: #666666;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    if root.has_device && root.is_ready && !root.is_mirroring: VerticalLayout {
                        alignment: center;
                        spacing: 16px;

                        // Card central do dispositivo conectado (identidade visual sobre a tela desfocada)
                        Rectangle {
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #222222;
                            background: #090909e6;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 6px;
                                alignment: center;

                                // Nome do dispositivo em maior
                                Text {
                                    text: root.display_name;
                                    color: #ffffff;
                                    font-size: 16px;
                                    font-weight: 800;
                                    letter-spacing: 0.3px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                // Códigonome do dispositivo em menor
                                Text {
                                    text: root.model;
                                    color: #777777;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    if root.has_device && root.is_mirroring: VerticalLayout {
                        alignment: center;
                        spacing: 16px;

                        // Card central de monitoramento da transmissão ativa (sem a bola verde)
                        Rectangle {
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #222222;
                            background: #090909e6;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: center;

                                // Tipografia e hierarquia de status monocromática
                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "TRANSMISSÃO ATIVA";
                                        color: #ffffff;
                                        font-size: 9px;
                                        font-weight: 800;
                                        letter-spacing: 1.5px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: root.display_name;
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 800;
                                        letter-spacing: 0.3px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: root.model;
                                        color: #666666;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Texto informativo de UX
                                Text {
                                    text: "A tela do smartphone está aberta na janela flutuante independente.";
                                    color: #777777;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                // Botão de ação
                                MonoButton {
                                    text: "ENCERRAR SESSÃO";
                                    custom_height: 32px;
                                    padding_horizontal: 16px;
                                    clicked => { root.mirror_clicked(); }
                                }
                            }
                        }
                    }
                }

                // Barra Home Indicator do iPhone (barra inferior de gestos)
                HorizontalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 104px;
                        height: 4.5px;
                        border-radius: 2.25px;
                        background: #ffffffd8;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Mirro";
    icon: @image-url("icons/mirro-icon.svg");
    min-width: 1040px;
    min-height: 660px;
    preferred-width: 1180px;
    preferred-height: 720px;
    background: #000000;
    default-font-family: "Poppins, Segoe UI, sans-serif";

    in-out property <[DeviceCardData]> devices: [];
    in-out property <[MirroFileData]> mirro_files: [];
    in-out property <bool> is_loading_files: false;
    in-out property <bool> is_refreshing: false;
    in-out property <bool> show_rename_dialog: false;
    in-out property <string> rename_serial: "";
    in-out property <string> rename_text: "";
    in-out property <bool> turn_screen_off: true;
    in-out property <bool> mirror_always_on_top: false;
    in-out property <int> selected_device_index: 0;
    in-out property <string> active_nav: "devices";
    in-out property <image> screen_image;
    in-out property <bool> has_screen_image: false;
    in-out property <bool> quick_back: true;
    in-out property <bool> quick_recents: true;
    in-out property <bool> quick_home: true;
    in-out property <bool> quick_power: true;
    in-out property <bool> quick_volup: false;
    in-out property <bool> quick_voldown: false;
    in-out property <bool> quick_screenshot: false;
    in-out property <bool> quick_menu: false;
    in-out property <string> screenshot_save_path: "";
    in-out property <string> toast_message: "";
    in-out property <bool> show_toast: false;

    // Propriedades e estados da área de arquivos /mirro
    in-out property <string> current_mirro_dir: "/sdcard/mirro";
    in-out property <bool> is_in_subfolder: false;
    in-out property <int> selected_file_idx: -1;
    in-out property <string> selected_file_name: "";
    in-out property <string> clipboard_file_name: "";
    in-out property <string> clipboard_source_dir: "";
    in-out property <bool> has_clipboard_file: false;
    in-out property <bool> is_cut_mode: false;

    // Menu suspenso (Context Menu) de arquivos
    in-out property <bool> show_file_context_menu: false;
    in-out property <length> context_menu_y: 110px;
    in-out property <int> context_menu_file_idx: -1;
    in-out property <string> context_menu_file_name: "";
    in-out property <bool> context_menu_is_dir: false;

    // Visualizador e Editor de Arquivo Modal
    in-out property <bool> show_file_viewer: false;
    in-out property <string> viewer_file_name: "";
    in-out property <string> viewer_file_path: "";
    in-out property <string> viewer_file_content: "";
    in-out property <string> viewer_status_badge: "PRONTO";
    in-out property <bool> viewer_is_image: false;
    in-out property <image> viewer_image_data;

    callback refresh_requested();
    callback refresh_mirro_files();
    callback pick_and_send_file();
    callback mirror_toggled(string, bool, bool);
    callback device_selected(string);
    callback nav_action(string, string);
    callback start_rename(string, string);
    callback confirm_rename(string, string);
    callback cancel_rename();
    callback toggle_turn_screen_off(bool);
    callback toggle_always_on_top(bool);
    callback toggle_quick_shortcut(string, bool);
    callback choose_screenshot_dir();
    callback open_screenshot_dir();
    callback reset_screenshot_dir();

    // Callbacks da área de arquivos
    callback open_file(string, bool);
    callback file_single_clicked(int, string, bool);
    callback file_right_clicked(int, string, bool, length);
    callback copy_file_action(string);
    callback cut_file_action(string);
    callback paste_file_action();
    callback delete_file_action(string);
    callback download_file_action(string);
    callback navigate_parent_dir();
    callback save_viewer_file(string);
    callback open_viewer_file_in_pc();
    callback close_file_viewer();

    property <bool> has_devices: root.devices.length > 0;
    property <int> active_idx: (root.selected_device_index >= 0 && root.selected_device_index < root.devices.length) ? root.selected_device_index : 0;
    property <bool> has_selected: root.has_devices && root.active_idx < root.devices.length;

    property <string> sel_serial: root.has_selected ? root.devices[root.active_idx].serial : "";
    property <string> sel_name: root.has_selected ? root.devices[root.active_idx].display_name : "";
    property <string> sel_model: root.has_selected ? root.devices[root.active_idx].model : "";
    property <string> sel_status_text: root.has_selected ? root.devices[root.active_idx].status_text : "";
    property <string> sel_status_message: root.has_selected ? root.devices[root.active_idx].status_message : "";
    property <bool> sel_ready: root.has_selected ? root.devices[root.active_idx].is_ready : false;
    property <bool> sel_mirroring: root.has_selected ? root.devices[root.active_idx].is_mirroring : false;
    property <bool> sel_unauthorized: root.has_selected ? root.devices[root.active_idx].is_unauthorized : false;

    HorizontalLayout {
        // SIDEBAR ESQUERDA: Navbar e Lista de Telefones
        Rectangle {
            width: 280px;
            background: #080808;
            border-width: 0px;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: #1f1f1f;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Cabeçalho da Sidebar (Topo)
                HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    Text {
                        text: "MIRRO";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: #333333;
                        background: #111111;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            cross-axis-alignment: center;
                            Text {
                                text: "v0.1";
                                color: #777777;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Divisor
                Rectangle {
                    height: 1px;
                    vertical-stretch: 0;
                    background: #1a1a1a;
                }

                // ==========================================
                // SEÇÃO 1: NAVEGAÇÃO DA NAVBAR (Alinhada ao topo e à esquerda)
                // ==========================================
                NavButton {
                    icon_image: @image-url("icons/settings.svg");
                    label: "CONFIGURAÇÕES";
                    vertical-stretch: 0;
                    is_active: root.active_nav == "settings";
                    clicked => { root.active_nav = "settings"; }
                }

                NavButton {
                    icon_image: @image-url("icons/phone.svg");
                    label: "DISPOSITIVOS";
                    badge_text: root.devices.length > 0 ? (root.devices.length + "") : "";
                    vertical-stretch: 0;
                    is_active: root.active_nav == "devices";
                    clicked => { root.active_nav = "devices"; }
                }

                // Divisor
                Rectangle {
                    height: 1px;
                    vertical-stretch: 0;
                    background: #1a1a1a;
                }

                // ==========================================
                // SEÇÃO 2: APARELHOS CONECTADOS
                // ==========================================
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text {
                            text: "CONEXÕES";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.devices.length > 0 ? (root.devices.length + " ATIVO(S)") : "NENHUM";
                            color: #444444;
                            font-size: 9px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    if !root.has_devices: Rectangle {
                        height: 48px;
                        vertical-stretch: 0;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #161616;
                        background: #090909;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;
                            cross-axis-alignment: center;
                            spacing: 10px;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                clip: false;

                                Image {
                                    source: @image-url("icons/phone.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #444444;
                                }
                            }

                            Text {
                                text: "Nenhum celular plugado";
                                color: #555555;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if !root.has_devices: Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }

                    if root.has_devices: ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            for device[idx] in root.devices: Rectangle {
                                height: 56px;
                                border-radius: 4px;
                                border-width: (root.active_nav == "devices" && root.active_idx == idx) ? 1.5px : 1px;
                                border-color: (root.active_nav == "devices" && root.active_idx == idx) ? #ffffff : #1e1e1e;
                                background: (root.active_nav == "devices" && root.active_idx == idx) ? #161616 : (dev_ta.has-hover ? #121212 : #0b0b0b);

                                dev_ta := TouchArea {
                                    clicked => {
                                        root.selected_device_index = idx;
                                        root.active_nav = "devices";
                                        root.device_selected(device.serial);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        alignment: start;
                                        cross-axis-alignment: center;
                                        spacing: 10px;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            clip: false;

                                            Image {
                                                source: @image-url("icons/phone.svg");
                                                width: 16px;
                                                height: 16px;
                                                colorize: (root.active_nav == "devices" && root.active_idx == idx) ? #ffffff : #777777;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: device.display_name;
                                                color: #ffffff;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: device.serial;
                                                color: #666666;
                                                font-size: 9px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: end;
                                        cross-axis-alignment: center;

                                        // Bolinha verde indicadora de espelhamento ativo
                                        if device.is_mirroring: Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #22c55e;
                                        }

                                        // Indicador para aparelho não autorizado
                                        if !device.is_mirroring && device.is_unauthorized: Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #ef4444;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // ÁREA DIREITA: Muda conforme a navegação ativa
        // ==========================================
        Rectangle {
            background: #000000;

            // 1. TELA DE CONFIGURAÇÕES
            if root.active_nav == "settings": ScrollView {
                VerticalLayout {
                    padding: 28px;
                    spacing: 24px;
                    alignment: start;

                    // Cabeçalho de Configurações
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "CONFIGURAÇÕES";
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 800;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "Preferências de espelhamento, controle de hardware e conexões";
                            color: #777777;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #1a1a1a;
                    }

                    // Grupo 1: Espelhamento
                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "COMPORTAMENTO DA TELA";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #1e1e1e;
                            background: #090909;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "APAGAR TELA AO ESPELHAR";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Desliga a tela física do smartphone ao iniciar o espelhamento via scrcpy (--turn-screen-off). Economiza bateria e evita superaquecimento.";
                                            color: #888888;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    MonoToggle {
                                        horizontal-stretch: 0;
                                        checked: root.turn_screen_off;
                                        toggled(val) => {
                                            root.turn_screen_off = val;
                                            root.toggle_turn_screen_off(val);
                                        }
                                    }
                                }

                                // Divisor interno
                                Rectangle {
                                    height: 1px;
                                    background: #161616;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "SEMPRE NO TOPO";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Mantém a janela flutuante de espelhamento fixada sobre todas as outras janelas do computador durante o uso.";
                                            color: #888888;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    MonoToggle {
                                        horizontal-stretch: 0;
                                        checked: root.mirror_always_on_top;
                                        toggled(val) => {
                                            root.mirror_always_on_top = val;
                                            root.toggle_always_on_top(val);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Grupo 2: Captura de Tela e Armazenamento
                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "CAPTURA DE TELA E ARMAZENAMENTO";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #1e1e1e;
                            background: #090909;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                VerticalLayout {
                                    spacing: 4px;

                                    Text {
                                        text: "DIRETÓRIO DE CAPTURAS NO COMPUTADOR";
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: "Ao realizar uma captura de tela, a imagem é salva automaticamente na galeria do celular e nesta pasta selecionada no computador.";
                                        color: #888888;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }

                                Rectangle {
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #222222;
                                    background: #000000;
                                    height: 38px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: start;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: root.screenshot_save_path;
                                            color: #cccccc;
                                            font-size: 11px;
                                            font-weight: 500;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    MonoButton {
                                        text: "ALTERAR PASTA";
                                        custom_height: 32px;
                                        clicked => { root.choose_screenshot_dir(); }
                                    }

                                    MonoButton {
                                        text: "ABRIR NO EXPLORER";
                                        custom_height: 32px;
                                        clicked => { root.open_screenshot_dir(); }
                                    }

                                    MonoButton {
                                        text: "RESTAURAR PADRÃO";
                                        custom_height: 32px;
                                        clicked => { root.reset_screenshot_dir(); }
                                    }
                                }
                            }
                        }
                    }

                    // Grupo 3: Sistema e Conexão
                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "CONECTIVIDADE E SISTEMA";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #1e1e1e;
                            background: #090909;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "DETECÇÃO DE DISPOSITIVOS USB";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Reexecuta o reconhecimento de celulares conectados via Android Debug Bridge (ADB).";
                                            color: #888888;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    MonoButton {
                                        horizontal-stretch: 0;
                                        text: "ATUALIZAR DISPOSITIVOS";
                                        custom_height: 34px;
                                        clicked => { root.refresh_requested(); }
                                    }
                                }
                            }
                        }
                    }

                    // Rodapé Informativo
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 10px;

                        Text {
                            text: "Mirro Desktop v0.1 • Motor scrcpy C integrado";
                            color: #444444;
                            font-size: 10px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // 2. TELA DE DISPOSITIVOS: SEM CELULAR CONECTADO (ZERO MOCKUP)
            if root.active_nav == "devices" && !root.has_devices: VerticalLayout {
                alignment: center;
                padding: 40px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 480px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1a1a1a;
                        background: #080808;

                        VerticalLayout {
                            padding: 32px;
                            spacing: 22px;
                            alignment: center;

                            // Emblema central com ícone minimalista de escaneamento de celular
                            Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: 28px;
                                border-width: 1px;
                                border-color: #ffffff;
                                background: #111111;

                                Image {
                                    source: @image-url("icons/phone-search.svg");
                                    width: 28px;
                                    height: 28px;
                                    colorize: #ffffff;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    text: "NENHUM DISPOSITIVO CONECTADO";
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Conecte seu celular Android ao computador via cabo USB para iniciar o espelhamento.";
                                    color: #777777;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            MonoButton {
                                text: "ESCANEAR DISPOSITIVOS";
                                custom_height: 42px;
                                clicked => { root.refresh_requested(); }
                            }

                            Rectangle {
                                height: 1px;
                                background: #161616;
                            }

                            // Instruções
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "INSTRUÇÕES:";
                                    color: #555555;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: "1. Conecte o cabo USB ao computador e ao smartphone.";
                                    color: #888888;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "2. Habilite a 'Depuração USB' nas Opções de Desenvolvedor.";
                                    color: #888888;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "3. Se houver aviso na tela do celular, toque em 'Permitir'.";
                                    color: #888888;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // 3. TELA DE DISPOSITIVOS: COM CELULAR CONECTADO
            if root.active_nav == "devices" && root.has_devices: VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Barra Superior do Espaço de Trabalho
                HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.has_selected ? root.sel_name : "NENHUM DISPOSITIVO SELECIONADO";
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: root.has_selected ? (root.sel_model + " | " + root.sel_serial) : "SELECIONE UM APARELHO NA BARRA LATERAL";
                            color: #777777;
                            font-size: 11px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        cross-axis-alignment: center;

                        if root.has_selected && root.sel_ready: MonoButton {
                            text: root.sel_mirroring ? "ENCERRAR" : "ESPELHAR";
                            custom_height: 36px;
                            clicked => { root.mirror_toggled(root.sel_serial, root.turn_screen_off, root.mirror_always_on_top); }
                        }

                        if root.has_selected: MonoButton {
                            text: "RENOMEAR";
                            custom_height: 36px;
                            clicked => { root.start_rename(root.sel_serial, root.sel_name); }
                        }
                    }
                }

                // Divisor
                Rectangle {
                    vertical-stretch: 0;
                    height: 1px;
                    background: #1a1a1a;
                }

                // Palco Central: Moldura do Telefone + Painel de Funções + Seção de Arquivos (Centralizado Vertical e Horizontalmente)
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 24px;

                    // Moldura Estilo iPhone
                    GenericPhoneFrame {
                        display_name: root.sel_name;
                        serial: root.sel_serial;
                        model: root.sel_model;
                        is_ready: root.sel_ready;
                        is_mirroring: root.sel_mirroring;
                        is_unauthorized: root.sel_unauthorized;
                        has_device: root.has_selected;
                        screen_image: root.screen_image;
                        has_screen_image: root.has_screen_image;
                        mirror_clicked => { root.mirror_toggled(root.sel_serial, root.turn_screen_off, root.mirror_always_on_top); }
                    }

                    // Painel Lateral de Funções do Telefone
                    Rectangle {
                        width: 230px;
                        height: 580px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e1e1e;
                        background: #080808;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            // ==========================================
                            // SEÇÃO 1: NAVEGAÇÃO
                            // ==========================================
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    height: 18px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "NAVEGAÇÃO";
                                        color: #666666;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: center;
                                    }

                                    if btn_back.has_hover: Text {
                                        text: "VOLTAR";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                    if btn_recents.has_hover: Text {
                                        text: "RECENTES";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                    if btn_home.has_hover: Text {
                                        text: "INÍCIO";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    btn_back := IconButton {
                                        icon: @image-url("icons/back.svg");
                                        tooltip: "Voltar";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "back"); }
                                    }

                                    btn_recents := IconButton {
                                        icon: @image-url("icons/recents.svg");
                                        tooltip: "Recentes";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "recents"); }
                                    }

                                    btn_home := IconButton {
                                        icon: @image-url("icons/home.svg");
                                        tooltip: "Início";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "home"); }
                                    }
                                }
                            }

                            // Divisor fino
                            Rectangle {
                                height: 1px;
                                background: #1a1a1a;
                            }

                            // ==========================================
                            // SEÇÃO 2: BOTÕES
                            // ==========================================
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    height: 18px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "BOTÕES";
                                        color: #666666;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: center;
                                    }

                                    if btn_power.has_hover: Text {
                                        text: "TELA ON/OFF";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                    if btn_volup.has_hover: Text {
                                        text: "VOLUME +";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                    if btn_voldown.has_hover: Text {
                                        text: "VOLUME -";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    btn_power := IconButton {
                                        icon: @image-url("icons/power.svg");
                                        tooltip: "Tela On/Off";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "power"); }
                                    }

                                    btn_volup := IconButton {
                                        icon: @image-url("icons/volume-up.svg");
                                        tooltip: "Aumentar Volume";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "volup"); }
                                    }

                                    btn_voldown := IconButton {
                                        icon: @image-url("icons/volume-down.svg");
                                        tooltip: "Diminuir Volume";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "voldown"); }
                                    }
                                }
                            }

                            // Divisor fino
                            Rectangle {
                                height: 1px;
                                background: #1a1a1a;
                            }

                            // ==========================================
                            // SEÇÃO 3: AÇÕES
                            // ==========================================
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    height: 18px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "AÇÕES";
                                        color: #666666;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: center;
                                    }

                                    if btn_screenshot.has_hover: Text {
                                        text: "CAPTURA DE TELA";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                    if btn_menu.has_hover: Text {
                                        text: "MENU";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    btn_screenshot := IconButton {
                                        icon: @image-url("icons/screenshot.svg");
                                        tooltip: "Captura de Tela";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "screenshot"); }
                                    }

                                    btn_menu := IconButton {
                                        icon: @image-url("icons/menu.svg");
                                        tooltip: "Menu";
                                        enabled: root.has_selected && root.sel_ready;
                                        clicked => { root.nav_action(root.sel_serial, "menu"); }
                                    }
                                }
                            }

                            // Divisor fino
                            Rectangle {
                                height: 1px;
                                background: #1a1a1a;
                            }

                            // ==========================================
                            // SEÇÃO 4: ATALHOS RÁPIDOS
                            // ==========================================
                            VerticalLayout {
                                spacing: 10px;
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: "ATALHOS RÁPIDOS";
                                        color: #666666;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                    }
                                    Text {
                                        text: "Escolha quais botões vão para o widget flutuante:";
                                        color: #444444;
                                        font-size: 9.5px;
                                        wrap: word-wrap;
                                    }
                                }

                                ScrollView {
                                    vertical-stretch: 1;

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: start;

                                        QuickShortcutItem {
                                            icon: @image-url("icons/back.svg");
                                            label: "Voltar";
                                            checked: root.quick_back;
                                            toggled(val) => {
                                                root.quick_back = val;
                                                root.toggle_quick_shortcut("back", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/recents.svg");
                                            label: "Recentes";
                                            checked: root.quick_recents;
                                            toggled(val) => {
                                                root.quick_recents = val;
                                                root.toggle_quick_shortcut("recents", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/home.svg");
                                            label: "Início";
                                            checked: root.quick_home;
                                            toggled(val) => {
                                                root.quick_home = val;
                                                root.toggle_quick_shortcut("home", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/power.svg");
                                            label: "Tela On/Off";
                                            checked: root.quick_power;
                                            toggled(val) => {
                                                root.quick_power = val;
                                                root.toggle_quick_shortcut("power", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/volume-up.svg");
                                            label: "Volume +";
                                            checked: root.quick_volup;
                                            toggled(val) => {
                                                root.quick_volup = val;
                                                root.toggle_quick_shortcut("volup", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/volume-down.svg");
                                            label: "Volume -";
                                            checked: root.quick_voldown;
                                            toggled(val) => {
                                                root.quick_voldown = val;
                                                root.toggle_quick_shortcut("voldown", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/screenshot.svg");
                                            label: "Captura de Tela";
                                            checked: root.quick_screenshot;
                                            toggled(val) => {
                                                root.quick_screenshot = val;
                                                root.toggle_quick_shortcut("screenshot", val);
                                            }
                                        }

                                        QuickShortcutItem {
                                            icon: @image-url("icons/menu.svg");
                                            label: "Menu";
                                            checked: root.quick_menu;
                                            toggled(val) => {
                                                root.quick_menu = val;
                                                root.toggle_quick_shortcut("menu", val);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // SEÇÃO DE ARQUIVOS EM /mirro (Ao lado direito das ações)
                    // ==========================================
                    Rectangle {
                        width: 250px;
                        height: 580px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e1e1e;
                        background: #080808;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            // Cabeçalho da Seção de Arquivos
                            VerticalLayout {
                                spacing: 4px;

                                HorizontalLayout {
                                    height: 20px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: root.is_in_subfolder ? "SUBPASTA" : "ARQUIVOS /MIRRO";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        height: 18px;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #333333;
                                        background: #111111;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: root.mirro_files.length > 0 ? (root.mirro_files.length + " ITEM(S)") : "VAZIO";
                                                color: #888888;
                                                font-size: 9px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.current_mirro_dir;
                                    color: #555555;
                                    font-size: 9.5px;
                                    overflow: elide;
                                }
                            }

                            // Ações Rápidas de Arquivos (com ícones padrão de Refresh e Upload)
                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                IconButton {
                                    icon: @image-url("icons/refresh.svg");
                                    custom_height: 32px;
                                    enabled: root.has_selected && root.sel_ready;
                                    clicked => { root.refresh_mirro_files(); }
                                }

                                IconButton {
                                    icon: @image-url("icons/upload.svg");
                                    custom_height: 32px;
                                    enabled: root.has_selected && root.sel_ready;
                                    clicked => { root.pick_and_send_file(); }
                                }

                                if root.has_clipboard_file: Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #ffffff;
                                    background: paste_btn_ta.has-hover ? #000000 : #ffffff;

                                    paste_btn_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.paste_file_action(); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: "COLAR";
                                            color: paste_btn_ta.has-hover ? #ffffff : #000000;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Navegação para voltar à pasta pai se estiver em subpasta
                            if root.is_in_subfolder: Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #222222;
                                background: back_dir_ta.has-hover ? #1c1c1c : #101010;

                                back_dir_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.navigate_parent_dir(); }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        Image {
                                            source: @image-url("icons/back.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: #888888;
                                        }
                                    }

                                    Text {
                                        text: ".. (Voltar para pasta anterior)";
                                        color: back_dir_ta.has-hover ? #ffffff : #888888;
                                        font-size: 10px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Divisor fino
                            Rectangle {
                                height: 1px;
                                background: #1a1a1a;
                            }

                            // Lista de Arquivos ou Estado Vazio
                            if root.mirro_files.length == 0: VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 10px;

                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    border-width: 1px;
                                    border-color: #222222;
                                    background: #0d0d0d;

                                    Image {
                                        source: @image-url("icons/folder.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #555555;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                Text {
                                    text: "PASTA VAZIA";
                                    color: #888888;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Arraste arquivos para o celular para salvar em /mirro.";
                                    color: #555555;
                                    font-size: 9.5px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            if root.mirro_files.length > 0: ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;

                                    for file[idx] in root.mirro_files: Rectangle {
                                        height: 26px;
                                        border-radius: 3px;
                                        background: (root.selected_file_idx == idx)
                                            ? #202020
                                            : (f_ta.has-hover ? #141414 : transparent);
                                        border-width: (root.selected_file_idx == idx) ? 1px : 0px;
                                        border-color: #383838;
                                        opacity: (root.is_cut_mode && root.clipboard_file_name == file.name && root.clipboard_source_dir == root.current_mirro_dir) ? 0.45 : 1.0;

                                        f_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.file_single_clicked(idx, file.name, file.is_dir);
                                            }
                                            pointer-event(ev) => {
                                                if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                                                    root.file_right_clicked(idx, file.name, file.is_dir, 110px + (idx * 28px));
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 8px;
                                            alignment: start;
                                            cross-axis-alignment: center;

                                            // Miniatura do ícone (pasta ou arquivo)
                                            Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                clip: false;

                                                Image {
                                                    source: file.is_dir ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: (root.selected_file_idx == idx || f_ta.has-hover) ? #ffffff : #777777;
                                                }
                                            }

                                            Text {
                                                text: file.name;
                                                color: (root.selected_file_idx == idx || f_ta.has-hover) ? #ffffff : (file.is_dir ? #ffffff : #cccccc);
                                                font-size: 11px;
                                                font-weight: file.is_dir ? 700 : 500;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }

                                            if file.is_dir: Text {
                                                text: ">";
                                                color: #444444;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Divisor fino inferior
                            Rectangle {
                                height: 1px;
                                background: #1a1a1a;
                            }

                            // Dica visual de arrastar e soltar
                            Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #1a1a1a;
                                background: #060606;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "SOLTE ARQUIVOS NO CELULAR";
                                        color: #444444;
                                        font-size: 8.5px;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Overlay transparente para fechar o menu de contexto ao clicar fora
                        if root.show_file_context_menu: TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.show_file_context_menu = false; }
                        }

                        // Menu suspenso (Context Menu igualzinho explorador de arquivos)
                        if root.show_file_context_menu: FileContextMenu {
                            x: 45px;
                            y: root.context_menu_y;
                            is_dir: root.context_menu_is_dir;
                            can_paste: root.has_clipboard_file;
                            open_clicked => {
                                root.show_file_context_menu = false;
                                root.open_file(root.context_menu_file_name, root.context_menu_is_dir);
                            }
                            copy_clicked => {
                                root.show_file_context_menu = false;
                                root.copy_file_action(root.context_menu_file_name);
                            }
                            cut_clicked => {
                                root.show_file_context_menu = false;
                                root.cut_file_action(root.context_menu_file_name);
                            }
                            paste_clicked => {
                                root.show_file_context_menu = false;
                                root.paste_file_action();
                            }
                            select_clicked => {
                                root.show_file_context_menu = false;
                                root.selected_file_idx = root.context_menu_file_idx;
                                root.selected_file_name = root.context_menu_file_name;
                            }
                            delete_clicked => {
                                root.show_file_context_menu = false;
                                root.delete_file_action(root.context_menu_file_name);
                            }
                            download_clicked => {
                                root.show_file_context_menu = false;
                                root.download_file_action(root.context_menu_file_name);
                            }
                        }
                    }
                }
            }
        }
    }
    }

    // Modal de Edição de Apelido do Celular (Preto e Branco)
    if root.show_rename_dialog: Rectangle {
        background: #000000bb;

        TouchArea {
            // Previne cliques atrás do modal
        }

        Rectangle {
            width: 360px;
            height: 180px;
            border-radius: 6px;
            background: #000000;
            border-width: 1px;
            border-color: #ffffff;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "RENOMEAR DISPOSITIVO";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 800;
                    letter-spacing: 0.5px;
                }

                input := LineEdit {
                    text: root.rename_text;
                    edited(txt) => { root.rename_text = txt; }
                }

                HorizontalLayout {
                    alignment: end;
                    cross-axis-alignment: center;
                    spacing: 10px;

                    MonoButton {
                        text: "CANCELAR";
                        custom_height: 32px;
                        clicked => { root.cancel_rename(); }
                    }

                    MonoButton {
                        text: "SALVAR";
                        custom_height: 32px;
                        clicked => { root.confirm_rename(root.rename_serial, input.text); }
                    }
                }
            }
        }
    }

    // Modal de Visualização e Edição Completa de Arquivos (Monocromático, sem emojis)
    if root.show_file_viewer: Rectangle {
        background: #000000dd;

        TouchArea {
            // Previne cliques atrás do modal
        }

        Rectangle {
            width: 760px;
            height: 540px;
            border-radius: 8px;
            background: #080808;
            border-width: 1px;
            border-color: #ffffff;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                // Header do Visualizador / Editor
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            Image {
                                source: root.viewer_is_image ? @image-url("icons/file.svg") : @image-url("icons/edit.svg");
                                width: 18px;
                                height: 18px;
                                colorize: #ffffff;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;

                            Text {
                                text: root.viewer_file_name;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                            }

                            Text {
                                text: root.viewer_file_path;
                                color: #666666;
                                font-size: 9.5px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Rectangle {
                            height: 20px;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #333333;
                            background: #111111;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                cross-axis-alignment: center;
                                Text {
                                    text: root.viewer_status_badge;
                                    color: #888888;
                                    font-size: 9px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 3px;
                            background: close_viewer_ta.has-hover ? #222222 : transparent;

                            close_viewer_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close_file_viewer(); }
                            }

                            Image {
                                source: @image-url("icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: close_viewer_ta.has-hover ? #ffffff : #888888;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // Divisor fino
                Rectangle { height: 1px; background: #1c1c1c; }

                // Área de visualização/edição
                if !root.viewer_is_image: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #222222;
                    background: #030303;
                    clip: true;

                    viewer_text_edit := TextEdit {
                        text: root.viewer_file_content;
                        font-size: 12px;
                        edited => {
                            root.viewer_file_content = self.text;
                            root.viewer_status_badge = "MODIFICADO";
                        }
                    }
                }

                if root.viewer_is_image: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #222222;
                    background: #030303;
                    clip: true;

                    Image {
                        source: root.viewer_image_data;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                        x: 10px;
                        y: 10px;
                    }
                }

                // Rodapé com Ações
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    Text {
                        text: root.viewer_is_image ? "Visualização de imagem do smartphone (/mirro)." : "Edite o texto e salve diretamente no celular ou abra no Windows.";
                        color: #555555;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;

                        MonoButton {
                            text: "ABRIR NO PC";
                            custom_height: 32px;
                            padding_horizontal: 14px;
                            clicked => { root.open_viewer_file_in_pc(); }
                        }

                        if !root.viewer_is_image: MonoButton {
                            text: "SALVAR NO CELULAR";
                            custom_height: 32px;
                            padding_horizontal: 14px;
                            clicked => { root.save_viewer_file(root.viewer_file_content); }
                        }

                        MonoButton {
                            text: "FECHAR";
                            custom_height: 32px;
                            padding_horizontal: 14px;
                            clicked => { root.close_file_viewer(); }
                        }
                    }
                }
            }
        }
    }

    // Notificação Toast Informativa de Captura de Tela (Monocromático, sem emojis)
    if root.show_toast: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: 560px;
        height: 60px;
        border-radius: 6px;
        background: #050505fa;
        border-width: 1px;
        border-color: #ffffff;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: space-between;
            cross-axis-alignment: center;
            spacing: 14px;

            Rectangle {
                width: 20px;
                height: 20px;
                Image {
                    source: @image-url("icons/screenshot.svg");
                    width: 20px;
                    height: 20px;
                }
            }

            Text {
                text: root.toast_message;
                color: #ffffff;
                font-size: 11px;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: ta_close.has-hover ? #222222 : transparent;

                ta_close := TouchArea {
                    clicked => { root.show_toast = false; }
                }

                Image {
                    source: @image-url("icons/close.svg");
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

export component CompanionWindow inherits Window {
    title: "Mirro Companion";
    no-frame: true;
    background: transparent;
    icon: @image-url("icons/mirro-icon.svg");

    in-out property <bool> is_expanded: false;
    in property <string> device_serial: "";
    in-out property <bool> show_back: true;
    in-out property <bool> show_recents: true;
    in-out property <bool> show_home: true;
    in-out property <bool> show_power: true;
    in-out property <bool> show_volup: false;
    in-out property <bool> show_voldown: false;
    in-out property <bool> show_screenshot: false;
    in-out property <bool> show_menu: false;

    callback toggle_expanded();
    callback action_triggered(string);

    property <int> active_count: (root.show_back ? 1 : 0) +
                                 (root.show_recents ? 1 : 0) +
                                 (root.show_home ? 1 : 0) +
                                 (root.show_power ? 1 : 0) +
                                 (root.show_volup ? 1 : 0) +
                                 (root.show_voldown ? 1 : 0) +
                                 (root.show_screenshot ? 1 : 0) +
                                 (root.show_menu ? 1 : 0) +
                                 1;

    width: 52px;
    height: root.is_expanded ? (56px + root.active_count * 39px) : 52px;

    main_container := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 26px;
        background: #000000;
        border-width: 1.5px;
        border-color: #ffffff;
        clip: true;

        if !root.is_expanded: Rectangle {
            width: 100%;
            height: 100%;
            background: circle_ta.has-hover ? #ffffff : #000000;

            circle_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle_expanded(); }
            }

            Rectangle {
                width: 20px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                Image {
                    source: @image-url("icons/menu.svg");
                    width: 20px;
                    height: 20px;
                    colorize: circle_ta.has-hover ? #000000 : #ffffff;
                }
            }
        }

        if root.is_expanded: VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 5px;
            alignment: center;
            cross-axis-alignment: center;

            // Botão superior para recolher de volta para círculo
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: collapse_ta.has-hover ? #ffffff : #111111;

                collapse_ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle_expanded(); }
                }

                Text {
                    text: "▲";
                    color: collapse_ta.has-hover ? #000000 : #ffffff;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Linha divisória sutil
            Rectangle {
                width: 24px;
                height: 1px;
                background: #333333;
            }

            if root.show_back: CompButton {
                icon: @image-url("icons/back.svg");
                clicked => { root.action_triggered("back"); }
            }

            if root.show_recents: CompButton {
                icon: @image-url("icons/recents.svg");
                clicked => { root.action_triggered("recents"); }
            }

            if root.show_home: CompButton {
                icon: @image-url("icons/home.svg");
                clicked => { root.action_triggered("home"); }
            }

            if root.show_power: CompButton {
                icon: @image-url("icons/power.svg");
                clicked => { root.action_triggered("power"); }
            }

            if root.show_volup: CompButton {
                icon: @image-url("icons/volume-up.svg");
                clicked => { root.action_triggered("volup"); }
            }

            if root.show_voldown: CompButton {
                icon: @image-url("icons/volume-down.svg");
                clicked => { root.action_triggered("voldown"); }
            }

            if root.show_screenshot: CompButton {
                icon: @image-url("icons/screenshot.svg");
                clicked => { root.action_triggered("screenshot"); }
            }

            if root.show_menu: CompButton {
                icon: @image-url("icons/menu.svg");
                clicked => { root.action_triggered("menu"); }
            }

            // Linha divisória sutil
            Rectangle {
                width: 24px;
                height: 1px;
                background: #333333;
            }

            // Encerrar espelhamento
            CompButton {
                icon: @image-url("icons/close.svg");
                clicked => { root.action_triggered("close"); }
            }
        }
    }
}
