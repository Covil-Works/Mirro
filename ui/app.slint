import { LineEdit, ScrollView } from "std-widgets.slint";
import "./fonts/Poppins-Regular.ttf";
import "./fonts/Poppins-Medium.ttf";
import "./fonts/Poppins-SemiBold.ttf";
import "./fonts/Poppins-Bold.ttf";

export struct DeviceCardData {
    serial: string,
    model: string,
    display_name: string,
    status_text: string,
    status_message: string,
    is_ready: bool,
    is_unauthorized: bool,
    is_mirroring: bool,
}

component MonoButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> custom_height: 36px;
    in property <length> padding_horizontal: 18px;
    callback clicked();

    height: root.custom_height;
    min-width: label.min-width + (root.padding_horizontal * 2);
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? #222222 : #ffffff;
    background: !root.enabled ? #111111 : (ta.has-hover ? #000000 : #ffffff);

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.padding_horizontal;
        padding-right: root.padding_horizontal;
        alignment: center;
        cross-axis-alignment: center;

        label := Text {
            text: root.text;
            color: !root.enabled ? #444444 : (ta.has-hover ? #ffffff : #000000);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component MonoToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);

    height: 28px;
    background: transparent;

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 2px;
            border-width: 1px;
            border-color: #ffffff;
            background: root.checked ? #ffffff : (ta.has-hover ? #1a1a1a : #000000);

            if root.checked: Rectangle {
                width: 8px;
                height: 8px;
                background: #000000;
                border-radius: 1px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.label != "": Text {
            text: root.label;
            color: ta.has-hover ? #ffffff : #999999;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

component NavButton inherits Rectangle {
    in property <image> icon_image;
    in property <string> label;
    in property <string> badge_text: "";
    in property <bool> is_active: false;
    callback clicked();

    height: 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.is_active ? #ffffff : (ta.has-hover ? #2a2a2a : transparent);
    background: root.is_active ? #161616 : (ta.has-hover ? #0f0f0f : transparent);

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    // Indicador ativo na borda esquerda
    if root.is_active: Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: #ffffff;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        // Ícone vetorial com container de dimensão fixa e centralização garantida
        Rectangle {
            width: 16px;
            height: 16px;
            clip: false;

            Image {
                source: root.icon_image;
                width: 16px;
                height: 16px;
                colorize: root.is_active ? #ffffff : (ta.has-hover ? #ffffff : #777777);
            }
        }

        // Texto do botão
        Text {
            text: root.label;
            color: root.is_active ? #ffffff : (ta.has-hover ? #ffffff : #888888);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }

        // Badge opcional (contador)
        if root.badge_text != "": Rectangle {
            height: 18px;
            border-radius: 9px;
            background: root.is_active ? #ffffff : #1e1e1e;
            border-width: 1px;
            border-color: root.is_active ? #ffffff : #333333;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.badge_text;
                    color: root.is_active ? #000000 : #888888;
                    font-size: 9px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component GenericPhoneFrame inherits Rectangle {
    in property <string> display_name: "";
    in property <string> serial: "";
    in property <string> model: "";
    in property <bool> is_ready: false;
    in property <bool> is_mirroring: false;
    in property <bool> is_unauthorized: false;
    in property <bool> has_device: false;
    callback mirror_clicked();

    width: 296px;
    height: 580px;
    background: transparent;

    // BOTÕES FÍSICOS LATERAIS DO IPHONE (Chassi Externo)
    // Esquerda: Botão de Ação (Action Button)
    Rectangle {
        x: 0px;
        y: 88px;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Esquerda: Volume +
    Rectangle {
        x: 0px;
        y: 118px;
        width: 3px;
        height: 38px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Esquerda: Volume -
    Rectangle {
        x: 0px;
        y: 164px;
        width: 3px;
        height: 38px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Direita: Botão Lateral (Power / Siri)
    Rectangle {
        x: parent.width - 3px;
        y: 124px;
        width: 3px;
        height: 52px;
        border-radius: 1.5px;
        background: #2e2e2e;
    }
    // Direita inferior: Controle de Câmera (Camera Control - iPhone 16)
    Rectangle {
        x: parent.width - 3px;
        y: 430px;
        width: 2.5px;
        height: 28px;
        border-radius: 1px;
        background: #252525;
    }

    // CHASSI PRINCIPAL DO IPHONE (Moldura de Titânio Fosco com Linhas de Antena)
    chassis := Rectangle {
        x: 3px;
        y: 0px;
        width: 290px;
        height: 580px;
        border-radius: 48px;
        background: #0d0d0d;
        border-width: 2px;
        border-color: #383838;

        // Linhas de antena do iPhone (entalhes sutis nas laterais do titânio)
        Rectangle { x: 0px; y: 60px; width: 2px; height: 2px; background: #222222; }
        Rectangle { x: parent.width - 2px; y: 60px; width: 2px; height: 2px; background: #222222; }
        Rectangle { x: 0px; y: parent.height - 62px; width: 2px; height: 2px; background: #222222; }
        Rectangle { x: parent.width - 2px; y: parent.height - 62px; width: 2px; height: 2px; background: #222222; }

        // Borda Chanfrada de Titânio/Alumínio Fosco (Anel interno de reflexo)
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: parent.width - 3px;
            height: parent.height - 3px;
            border-radius: 46.5px;
            border-width: 1px;
            border-color: #222222;
            background: transparent;
        }

        // Fenda ultrafina do alto-falante auricular no topo do vidro
        Rectangle {
            y: 2.5px;
            x: (parent.width - self.width) / 2;
            width: 44px;
            height: 1.5px;
            border-radius: 0.75px;
            background: #242424;
        }

        // TELA DO IPHONE: Borda ultrafina, perfeitamente uniforme e simétrica em todos os lados (5px)
        screen := Rectangle {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            border-radius: 43px;
            background: #000000;
            border-width: 1px;
            border-color: #1a1a1a;
            clip: true;

            // Ilha Dinâmica (Dynamic Island) no topo da tela do iPhone
            Rectangle {
                y: 10px;
                x: (parent.width - self.width) / 2;
                width: 82px;
                height: 24px;
                border-radius: 12px;
                background: #000000;
                border-width: 1px;
                border-color: #1e1e1e;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    // Sensor Face ID (TrueDepth)
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: #0c0c0c;
                    }

                    // Câmera Frontal (lente com anel óptico escuro)
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: #060606;
                        border-width: 1px;
                        border-color: #181818;
                    }
                }
            }

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 14px;
                padding-bottom: 10px;
                alignment: space-between;

                // Barra de Status Superior do iOS
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    // Hora de lançamento da Apple (9:41)
                    Text {
                        text: "9:41";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }

                    // Ícones de status do iOS (Sinal, Bateria)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        cross-axis-alignment: center;

                        Text {
                            text: "5G";
                            color: #ffffff;
                            font-size: 10px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        // Indicador de Bateria estilo iOS
                        HorizontalLayout {
                            spacing: 1.5px;
                            alignment: center;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 20px;
                                height: 10px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #888888;
                                background: transparent;

                                Rectangle {
                                    x: 1.5px;
                                    y: 1.5px;
                                    width: 13px;
                                    height: 7px;
                                    border-radius: 1.5px;
                                    background: #ffffff;
                                }
                            }

                            Rectangle {
                                width: 1.5px;
                                height: 4px;
                                border-radius: 0.75px;
                                background: #888888;
                            }
                        }
                    }
                }

                // Conteúdo central da tela
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    if !root.has_device: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "SEM DISPOSITIVO";
                            color: #444444;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                        }
                    }

                    if root.has_device && root.is_unauthorized: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Rectangle {
                            height: 26px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #ffffff;
                            background: #000000;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                cross-axis-alignment: center;
                                Text {
                                    text: "NÃO AUTORIZADO";
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.serial;
                            color: #666666;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    if root.has_device && root.is_ready && !root.is_mirroring: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: root.display_name;
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.model;
                            color: #777777;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                        MonoButton {
                            text: "ESPELHAR";
                            custom_height: 34px;
                            clicked => { root.mirror_clicked(); }
                        }
                    }

                    if root.has_device && root.is_mirroring: VerticalLayout {
                        alignment: center;
                        spacing: 16px;

                        // Card central de monitoramento da transmissão ativa
                        Rectangle {
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #222222;
                            background: #090909;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: center;

                                // Indicador visual em radar (pulse beacon verde esmeralda)
                                HorizontalLayout {
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 38px;
                                        height: 38px;
                                        border-radius: 19px;
                                        background: #22c55e14;
                                        border-width: 1px;
                                        border-color: #22c55e33;

                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: #22c55e28;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;

                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: #22c55e;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                }

                                // Tipografia e hierarquia de status
                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "TRANSMISSÃO ATIVA";
                                        color: #22c55e;
                                        font-size: 9px;
                                        font-weight: 800;
                                        letter-spacing: 1.5px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: root.display_name;
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 800;
                                        letter-spacing: 0.3px;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: root.model;
                                        color: #666666;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Texto informativo de UX
                                Text {
                                    text: "A tela do smartphone está aberta na janela flutuante independente.";
                                    color: #777777;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                // Botão de ação
                                MonoButton {
                                    text: "ENCERRAR SESSÃO";
                                    custom_height: 32px;
                                    padding_horizontal: 16px;
                                    clicked => { root.mirror_clicked(); }
                                }
                            }
                        }
                    }
                }

                // Barra Home Indicator do iPhone (barra inferior de gestos)
                HorizontalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 104px;
                        height: 4.5px;
                        border-radius: 2.25px;
                        background: #ffffffd8;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Mirro";
    icon: @image-url("../tools/scrcpy/scrcpy.png");
    min-width: 960px;
    min-height: 660px;
    preferred-width: 1080px;
    preferred-height: 720px;
    background: #000000;
    default-font-family: "Poppins, Segoe UI, sans-serif";

    in-out property <[DeviceCardData]> devices: [];
    in-out property <bool> is_refreshing: false;
    in-out property <bool> show_rename_dialog: false;
    in-out property <string> rename_serial: "";
    in-out property <string> rename_text: "";
    in-out property <bool> turn_screen_off: true;
    in-out property <bool> mirror_always_on_top: true;
    in-out property <int> selected_device_index: 0;
    in-out property <string> active_nav: "devices";

    callback refresh_requested();
    callback mirror_toggled(string, bool, bool);
    callback nav_action(string, string);
    callback start_rename(string, string);
    callback confirm_rename(string, string);
    callback cancel_rename();
    callback toggle_turn_screen_off(bool);
    callback toggle_always_on_top(bool);

    property <bool> has_devices: root.devices.length > 0;
    property <int> active_idx: (root.selected_device_index >= 0 && root.selected_device_index < root.devices.length) ? root.selected_device_index : 0;
    property <bool> has_selected: root.has_devices && root.active_idx < root.devices.length;

    property <string> sel_serial: root.has_selected ? root.devices[root.active_idx].serial : "";
    property <string> sel_name: root.has_selected ? root.devices[root.active_idx].display_name : "";
    property <string> sel_model: root.has_selected ? root.devices[root.active_idx].model : "";
    property <string> sel_status_text: root.has_selected ? root.devices[root.active_idx].status_text : "";
    property <string> sel_status_message: root.has_selected ? root.devices[root.active_idx].status_message : "";
    property <bool> sel_ready: root.has_selected ? root.devices[root.active_idx].is_ready : false;
    property <bool> sel_mirroring: root.has_selected ? root.devices[root.active_idx].is_mirroring : false;
    property <bool> sel_unauthorized: root.has_selected ? root.devices[root.active_idx].is_unauthorized : false;

    HorizontalLayout {
        // SIDEBAR ESQUERDA: Navbar e Lista de Telefones
        Rectangle {
            width: 280px;
            background: #080808;
            border-width: 0px;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: #1f1f1f;
            }

            VerticalLayout {
                alignment: start;
                padding: 16px;
                spacing: 12px;

                // Cabeçalho da Sidebar (Topo)
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    Text {
                        text: "MIRRO";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: #333333;
                        background: #111111;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            cross-axis-alignment: center;
                            Text {
                                text: "v0.1";
                                color: #777777;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Divisor
                Rectangle {
                    height: 1px;
                    background: #1a1a1a;
                }

                // ==========================================
                // SEÇÃO 1: NAVEGAÇÃO DA NAVBAR (Alinhada ao topo e à esquerda)
                // ==========================================
                NavButton {
                    icon_image: @image-url("icons/settings.svg");
                    label: "CONFIGURAÇÕES";
                    is_active: root.active_nav == "settings";
                    clicked => { root.active_nav = "settings"; }
                }

                NavButton {
                    icon_image: @image-url("icons/phone.svg");
                    label: "DISPOSITIVOS";
                    badge_text: root.devices.length > 0 ? (root.devices.length + "") : "";
                    is_active: root.active_nav == "devices";
                    clicked => { root.active_nav = "devices"; }
                }

                // Divisor
                Rectangle {
                    height: 1px;
                    background: #1a1a1a;
                }

                // ==========================================
                // SEÇÃO 2: APARELHOS CONECTADOS
                // ==========================================
                VerticalLayout {
                    alignment: start;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text {
                            text: "CONEXÕES";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.devices.length > 0 ? (root.devices.length + " ATIVO(S)") : "NENHUM";
                            color: #444444;
                            font-size: 9px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    if !root.has_devices: Rectangle {
                        height: 48px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #161616;
                        background: #090909;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;
                            cross-axis-alignment: center;
                            spacing: 10px;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                clip: false;

                                Image {
                                    source: @image-url("icons/phone.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #444444;
                                }
                            }

                            Text {
                                text: "Nenhum celular plugado";
                                color: #555555;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.has_devices: ScrollView {
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            for device[idx] in root.devices: Rectangle {
                                height: 56px;
                                border-radius: 4px;
                                border-width: (root.active_nav == "devices" && root.active_idx == idx) ? 1.5px : 1px;
                                border-color: (root.active_nav == "devices" && root.active_idx == idx) ? #ffffff : #1e1e1e;
                                background: (root.active_nav == "devices" && root.active_idx == idx) ? #161616 : (dev_ta.has-hover ? #121212 : #0b0b0b);

                                dev_ta := TouchArea {
                                    clicked => {
                                        root.selected_device_index = idx;
                                        root.active_nav = "devices";
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        alignment: start;
                                        cross-axis-alignment: center;
                                        spacing: 10px;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            clip: false;

                                            Image {
                                                source: @image-url("icons/phone.svg");
                                                width: 16px;
                                                height: 16px;
                                                colorize: (root.active_nav == "devices" && root.active_idx == idx) ? #ffffff : #777777;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: device.display_name;
                                                color: #ffffff;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: device.serial;
                                                color: #666666;
                                                font-size: 9px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: end;
                                        cross-axis-alignment: center;

                                        // Bolinha verde indicadora de espelhamento ativo
                                        if device.is_mirroring: Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #22c55e;
                                        }

                                        // Indicador para aparelho não autorizado
                                        if !device.is_mirroring && device.is_unauthorized: Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #ef4444;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // ÁREA DIREITA: Muda conforme a navegação ativa
        // ==========================================
        Rectangle {
            background: #000000;

            // 1. TELA DE CONFIGURAÇÕES
            if root.active_nav == "settings": ScrollView {
                VerticalLayout {
                    padding: 28px;
                    spacing: 24px;
                    alignment: start;

                    // Cabeçalho de Configurações
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "CONFIGURAÇÕES";
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 800;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "Preferências de espelhamento, controle de hardware e conexões";
                            color: #777777;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #1a1a1a;
                    }

                    // Grupo 1: Espelhamento
                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "COMPORTAMENTO DA TELA";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #1e1e1e;
                            background: #090909;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "APAGAR TELA AO ESPELHAR";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Desliga a tela física do smartphone ao iniciar o espelhamento via scrcpy (--turn-screen-off). Economiza bateria e evita superaquecimento.";
                                            color: #888888;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    MonoToggle {
                                        horizontal-stretch: 0;
                                        checked: root.turn_screen_off;
                                        toggled(val) => {
                                            root.turn_screen_off = val;
                                            root.toggle_turn_screen_off(val);
                                        }
                                    }
                                }

                                // Divisor interno
                                Rectangle {
                                    height: 1px;
                                    background: #161616;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "SEMPRE NO TOPO";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Mantém a janela flutuante de espelhamento fixada sobre todas as outras janelas do computador durante o uso.";
                                            color: #888888;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    MonoToggle {
                                        horizontal-stretch: 0;
                                        checked: root.mirror_always_on_top;
                                        toggled(val) => {
                                            root.mirror_always_on_top = val;
                                            root.toggle_always_on_top(val);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Grupo 2: Sistema e Conexão
                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "CONECTIVIDADE E SISTEMA";
                            color: #555555;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #1e1e1e;
                            background: #090909;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 16px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "DETECÇÃO DE DISPOSITIVOS USB";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Reexecuta o reconhecimento de celulares conectados via Android Debug Bridge (ADB).";
                                            color: #888888;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    MonoButton {
                                        horizontal-stretch: 0;
                                        text: "ATUALIZAR DISPOSITIVOS";
                                        custom_height: 34px;
                                        clicked => { root.refresh_requested(); }
                                    }
                                }
                            }
                        }
                    }

                    // Rodapé Informativo
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 10px;

                        Text {
                            text: "Mirro Desktop v0.1 • Motor scrcpy C integrado";
                            color: #444444;
                            font-size: 10px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // 2. TELA DE DISPOSITIVOS: SEM CELULAR CONECTADO (ZERO MOCKUP)
            if root.active_nav == "devices" && !root.has_devices: VerticalLayout {
                alignment: center;
                padding: 40px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 480px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1a1a1a;
                        background: #080808;

                        VerticalLayout {
                            padding: 32px;
                            spacing: 22px;
                            alignment: center;

                            // Emblema central com ícone minimalista de escaneamento de celular
                            Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: 28px;
                                border-width: 1px;
                                border-color: #ffffff;
                                background: #111111;

                                Image {
                                    source: @image-url("icons/phone-search.svg");
                                    width: 28px;
                                    height: 28px;
                                    colorize: #ffffff;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    text: "NENHUM DISPOSITIVO CONECTADO";
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Conecte seu celular Android ao computador via cabo USB para iniciar o espelhamento.";
                                    color: #777777;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            MonoButton {
                                text: "ESCANEAR DISPOSITIVOS";
                                custom_height: 42px;
                                clicked => { root.refresh_requested(); }
                            }

                            Rectangle {
                                height: 1px;
                                background: #161616;
                            }

                            // Instruções
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "INSTRUÇÕES:";
                                    color: #555555;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: "1. Conecte o cabo USB ao computador e ao smartphone.";
                                    color: #888888;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "2. Habilite a 'Depuração USB' nas Opções de Desenvolvedor.";
                                    color: #888888;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "3. Se houver aviso na tela do celular, toque em 'Permitir'.";
                                    color: #888888;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // 3. TELA DE DISPOSITIVOS: COM CELULAR CONECTADO
            if root.active_nav == "devices" && root.has_devices: VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Barra Superior do Espaço de Trabalho
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.has_selected ? root.sel_name : "NENHUM DISPOSITIVO SELECIONADO";
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: root.has_selected ? (root.sel_model + " | " + root.sel_serial) : "SELECIONE UM APARELHO NA BARRA LATERAL";
                            color: #777777;
                            font-size: 11px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        cross-axis-alignment: center;

                        if root.has_selected && root.sel_ready: MonoButton {
                            text: root.sel_mirroring ? "ENCERRAR" : "ESPELHAR";
                            custom_height: 36px;
                            clicked => { root.mirror_toggled(root.sel_serial, root.turn_screen_off, root.mirror_always_on_top); }
                        }

                        if root.has_selected: MonoButton {
                            text: "RENOMEAR";
                            custom_height: 36px;
                            clicked => { root.start_rename(root.sel_serial, root.sel_name); }
                        }
                    }
                }

                // Divisor
                Rectangle {
                    height: 1px;
                    background: #1a1a1a;
                }

                // Palco Central: Moldura do Telefone + Painel de Funções ao lado
                HorizontalLayout {
                    alignment: center;
                    spacing: 36px;

                    // Moldura Estilo iPhone
                    GenericPhoneFrame {
                        display_name: root.sel_name;
                        serial: root.sel_serial;
                        model: root.sel_model;
                        is_ready: root.sel_ready;
                        is_mirroring: root.sel_mirroring;
                        is_unauthorized: root.sel_unauthorized;
                        has_device: root.has_selected;
                        mirror_clicked => { root.mirror_toggled(root.sel_serial, root.turn_screen_off, root.mirror_always_on_top); }
                    }

                    // Painel Lateral de Funções do Telefone
                    Rectangle {
                        width: 220px;
                        height: 580px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e1e1e;
                        background: #080808;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 16px;

                            // Grupo 1: Navegação do Android
                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "NAVEGAÇÃO";
                                    color: #666666;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                MonoButton {
                                    text: "VOLTAR";
                                    enabled: root.has_selected && root.sel_ready;
                                    custom_height: 32px;
                                    clicked => { root.nav_action(root.sel_serial, "back"); }
                                }

                                MonoButton {
                                    text: "INÍCIO";
                                    enabled: root.has_selected && root.sel_ready;
                                    custom_height: 32px;
                                    clicked => { root.nav_action(root.sel_serial, "home"); }
                                }

                                MonoButton {
                                    text: "RECENTES";
                                    enabled: root.has_selected && root.sel_ready;
                                    custom_height: 32px;
                                    clicked => { root.nav_action(root.sel_serial, "recents"); }
                                }

                                MonoButton {
                                    text: "TELA ON/OFF";
                                    enabled: root.has_selected && root.sel_ready;
                                    custom_height: 32px;
                                    clicked => { root.nav_action(root.sel_serial, "power"); }
                                }
                            }

                            // Grupo 2: Áudio
                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "VOLUME";
                                    color: #666666;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    MonoButton {
                                        text: "VOL +";
                                        enabled: root.has_selected && root.sel_ready;
                                        custom_height: 32px;
                                        clicked => { root.nav_action(root.sel_serial, "volup"); }
                                    }

                                    MonoButton {
                                        text: "VOL -";
                                        enabled: root.has_selected && root.sel_ready;
                                        custom_height: 32px;
                                        clicked => { root.nav_action(root.sel_serial, "voldown"); }
                                    }
                                }
                            }

                            // Grupo 3: Ações do Dispositivo
                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "AÇÕES";
                                    color: #666666;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                MonoButton {
                                    text: "CAPTURA DE TELA";
                                    enabled: root.has_selected && root.sel_ready;
                                    custom_height: 32px;
                                    clicked => { root.nav_action(root.sel_serial, "screenshot"); }
                                }

                                MonoButton {
                                    text: "MENU";
                                    enabled: root.has_selected && root.sel_ready;
                                    custom_height: 32px;
                                    clicked => { root.nav_action(root.sel_serial, "menu"); }
                                }
                            }

                            // Grupo 4: Área para Funções Futuras
                            VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: "FUNÇÕES ADICIONAIS";
                                    color: #444444;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }

                                Rectangle {
                                    height: 56px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #1a1a1a;
                                    background: #000000;

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "+ ADICIONAR";
                                            color: #333333;
                                            font-size: 10px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Edição de Apelido do Celular (Preto e Branco)
    if root.show_rename_dialog: Rectangle {
        background: #000000bb;

        TouchArea {
            // Previne cliques atrás do modal
        }

        Rectangle {
            width: 360px;
            height: 180px;
            border-radius: 6px;
            background: #000000;
            border-width: 1px;
            border-color: #ffffff;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "RENOMEAR DISPOSITIVO";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 800;
                    letter-spacing: 0.5px;
                }

                input := LineEdit {
                    text: root.rename_text;
                    edited(txt) => { root.rename_text = txt; }
                }

                HorizontalLayout {
                    alignment: end;
                    cross-axis-alignment: center;
                    spacing: 10px;

                    MonoButton {
                        text: "CANCELAR";
                        custom_height: 32px;
                        clicked => { root.cancel_rename(); }
                    }

                    MonoButton {
                        text: "SALVAR";
                        custom_height: 32px;
                        clicked => { root.confirm_rename(root.rename_serial, input.text); }
                    }
                }
            }
        }
    }
}
